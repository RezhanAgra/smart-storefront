# Salin menjadi .env.prod di VPS, lalu isi semua nilai. Jangan commit .env.prod.

# --- Domain & HTTPS (dipakai Caddy dan build client)
DOMAIN_NAME=tokoku.id
ACME_EMAIL=admin@tokoku.id

# --- Server API
# Host "mongo" adalah nama service di docker-compose.prod.yml.
DATABASE_URL=mongodb://mongo:27017/smart_storefront?replicaSet=rs0
# Buat dengan: openssl rand -hex 32
JWT_SECRET=ganti_dengan_hasil_openssl_rand_hex_32
# Origin client, untuk CORS. Sama dengan https://DOMAIN_NAME.
CLIENT_URL=https://tokoku.id
# Origin publik API, untuk URL gambar hasil upload. API dan client satu domain di belakang Caddy.
SERVER_PUBLIC_URL=https://tokoku.id
# Rahasia bersama server dan client (SSR). Buat dengan: openssl rand -hex 32
INTERNAL_API_KEY=ganti_dengan_hasil_openssl_rand_hex_32

# --- Midtrans (kosongkan keduanya untuk menonaktifkan checkout online)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# true untuk transaksi sungguhan (key produksi), false untuk sandbox
MIDTRANS_IS_PRODUCTION=false
