# Salin menjadi scripts/backup.env (tidak masuk git) lalu isi. Semua opsional kecuali yang ditandai.

# Folder backup lokal di VPS.
BACKUP_DIR=/var/backups/smart-storefront
# Backup lokal yang lebih tua dari N hari dihapus.
RETENTION_DAYS=7

# WAJIB untuk backup di luar VPS: nama remote rclone + path. Buat remote dengan `rclone config`.
# Contoh: r2:smart-storefront-backup/daily  |  s3:nama-bucket/smart-storefront  |  gdrive:Backup/smart-storefront
RCLONE_REMOTE=
# Hapus file di remote yang lebih tua dari N hari (kosong = tidak pernah dihapus).
REMOTE_RETENTION_DAYS=30

# Notifikasi saat gagal (isi salah satu atau keduanya).
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 1 = kirim notifikasi juga saat berhasil.
NOTIFY_ON_SUCCESS=0

# Dead man's switch (misalnya healthchecks.io): di-ping setiap backup berhasil, sehingga kamu juga
# diberi tahu jika cron sama sekali tidak berjalan.
HEARTBEAT_URL=

# 0 = hanya database, tanpa arsip volume uploads & private-uploads.
INCLUDE_FILES=1
