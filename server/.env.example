PORT=5000
DATABASE_URL="mongodb://localhost:27017/smart_storefront?replicaSet=rs0"
JWT_SECRET="dev_super_secret_key_change_in_prod"
CLIENT_URL="http://localhost:4321"
# Midtrans Snap (sandbox). Ambil dari dashboard.sandbox.midtrans.com > Settings > Access Keys.
# Jika kosong, checkout dinonaktifkan dan tombol Beli memakai link pembelian penjual.
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"
# URL publik server ini, untuk URL gambar hasil upload. Production: https://api.domainmu.id
SERVER_PUBLIC_URL="http://localhost:5000"
# Rahasia bersama dengan client Astro (isi INTERNAL_API_KEY yang sama di client/.env).
# Request SSR dari server Astro membawa header ini sehingga tidak terkena rate limit per IP.
INTERNAL_API_KEY="ganti_dengan_string_acak_panjang"
# SMTP untuk email struk ke pembeli, notifikasi pesanan ke penjual, dan reset password.
# Kosongkan SMTP_HOST untuk menonaktifkan email. Port 465 = SSL, 587 = STARTTLS.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
# Alamat pengirim, misalnya "SmartStorefront <noreply@tokoku.id>"
MAIL_FROM=""

# Akun super admin yang dibuat oleh `npm run seed` (production: password minimal 12 karakter).
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
