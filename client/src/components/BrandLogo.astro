---
/**
 * Logo SmartStorefront: ikon (tas belanja dengan tali berbentuk mata rantai tautan, artinya
 * "link-in-bio + toko") di dalam kotak kaca, ditambah wordmark dua warna.
 */
interface Props {
  size?: "sm" | "md" | "lg";
  /** Tujuan tautan logo. */
  href?: string;
  /** Badge "PRO" di kanan wordmark. Ukuran md menyembunyikannya di layar < 640px agar navbar tetap satu baris. */
  badge?: boolean;
  class?: string;
}

const { size = "md", href = "/", badge = true, class: className } = Astro.props;

const SIZES = {
  sm: { box: "size-7 rounded-lg", icon: "size-4", text: "text-base", gap: "gap-2" },
  md: { box: "size-9 rounded-xl", icon: "size-5", text: "text-lg", gap: "gap-2.5" },
  lg: { box: "size-11 rounded-2xl", icon: "size-6", text: "text-2xl", gap: "gap-3" },
} as const;
const s = SIZES[size];

// id gradien harus unik per logo, karena satu halaman bisa memuat lebih dari satu logo.
const gradientId = `brand-grad-${Math.random().toString(36).slice(2, 8)}`;
---

<a
  href={href}
  class:list={["group inline-flex min-h-11 shrink-0 items-center rounded-xl", s.gap, className]}
>
  <span
    class:list={[
      "flex items-center justify-center border border-white/20 bg-linear-to-tr/srgb from-indigo-500/20 via-purple-500/20 to-cyan-400/20 shadow-[inset_0_1px_0_rgba(255,255,255,0.3)] backdrop-blur-md transition-transform duration-300 group-hover:scale-105",
      s.box,
    ]}
    aria-hidden="true"
  >
    <svg viewBox="0 0 24 24" fill="none" class={s.icon}>
      <defs>
        <linearGradient id={gradientId} x1="4" y1="3" x2="20" y2="21" gradientUnits="userSpaceOnUse">
          <stop stop-color="#818cf8" />
          <stop offset="1" stop-color="#22d3ee" />
        </linearGradient>
      </defs>
      {/* Tali tas: dua mata rantai yang saling mengait. Bagian bawahnya tertutup badan tas. */}
      <rect x="6.6" y="2.6" width="6.2" height="9" rx="3.1" stroke={`url(#${gradientId})`} stroke-width="1.8" />
      <rect x="11.2" y="2.6" width="6.2" height="9" rx="3.1" stroke={`url(#${gradientId})`} stroke-width="1.8" />
      {/* Badan tas. Isi gelap menutup ujung bawah rantai, lalu lapisan gradien tipis di atasnya. */}
      <path d="M4.5 9h15l-1.3 10.4a2 2 0 0 1-2 1.6H7.8a2 2 0 0 1-2-1.6L4.5 9Z" fill="#0d1122" />
      <path
        d="M4.5 9h15l-1.3 10.4a2 2 0 0 1-2 1.6H7.8a2 2 0 0 1-2-1.6L4.5 9Z"
        fill={`url(#${gradientId})`}
        fill-opacity="0.18"
        stroke={`url(#${gradientId})`}
        stroke-width="1.8"
        stroke-linejoin="round"
      />
    </svg>
  </span>

  {/* Syne sangat lebar: di ponsel, logo ukuran md menyusun wordmark dua baris agar muat di samping tombol navbar. */}
  <span
    class:list={[
      "font-brand font-extrabold leading-none tracking-tight",
      s.text,
      size === "md" && "max-sm:flex max-sm:flex-col max-sm:text-[13px] max-sm:leading-[1.05]",
    ]}
  >
    <span class="text-white">Smart</span><span class="text-indigo-200 transition-colors group-hover:text-indigo-100">Storefront</span>
  </span>

  {
    badge && (
      <span
        class:list={[
          "rounded-md border border-white/15 bg-white/10 px-1.5 py-0.5 text-[10px] font-semibold uppercase leading-none tracking-wider text-cyan-300",
          size === "md" ? "max-sm:hidden" : "max-[359px]:hidden",
        ]}
      >
        Pro
      </span>
    )
  }
</a>
