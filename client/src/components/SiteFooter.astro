---
import BrandLogo from "./BrandLogo.astro";

const year = new Date().getFullYear();
const links = [
  { href: "/login", label: "Masuk" },
  { href: "/login?mode=register", label: "Daftar" },
  // Toko contoh dari `npm run seed` di server.
  { href: "/demo", label: "Akun Demo" },
];
---

<footer class="mx-auto max-w-5xl px-5 pb-10 pt-6">
  <div class="flex flex-col gap-6 border-t border-white/10 pt-8 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <BrandLogo size="sm" />
      <p class="mt-1 text-sm text-slate-400">Link-in-bio dan etalase produk untuk kreator dan UMKM.</p>
    </div>
    <nav aria-label="Tautan footer">
      <ul class="flex flex-wrap gap-x-2">
        {
          links.map((l) => (
            <li>
              <a href={l.href} class="inline-flex min-h-11 items-center rounded-lg px-2 text-sm text-slate-300 hover:bg-white/[0.06] hover:text-white">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <p class="mt-6 text-xs text-slate-400">&copy; {year} SmartStorefront</p>
</footer>
