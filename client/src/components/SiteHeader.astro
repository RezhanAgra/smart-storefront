---
import BrandLogo from "./BrandLogo.astro";

interface Props {
  showLogin?: boolean;
  /** Tombol kecil "Mulai Gratis" ke form daftar (landing page). */
  showCta?: boolean;
}
const { showLogin = false, showCta = false } = Astro.props;
---

<header class="sticky top-4 z-50 mx-4 sm:mx-auto sm:max-w-5xl">
  <nav
    aria-label="Utama"
    class="surface flex min-h-14 items-center justify-between gap-x-2 rounded-2xl px-3 py-1.5 shadow-[0_8px_32px_rgba(0,0,0,0.4)] backdrop-blur sm:gap-x-4 sm:px-5"
  >
    <BrandLogo />
    <div class="flex shrink-0 items-center gap-2">
      {
        showLogin && (
          <a href="/login" class:list={["btn-ghost px-3 text-sm sm:px-4", showCta && "max-sm:hidden"]}>
            Masuk
          </a>
        )
      }
      {
        showCta && (
          <a href="/login?mode=register" class="btn-glow rounded-xl px-3 text-sm sm:px-4">
            Mulai Gratis
          </a>
        )
      }
    </div>
  </nav>
</header>
