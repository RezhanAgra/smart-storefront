---
/** Kartu form tunggal (lupa password, reset password) dengan header dan footer situs. */
import Base from "../layouts/Base.astro";
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";

interface Props {
  title: string;
  heading: string;
  intro: string;
}
const { title, heading, intro } = Astro.props;
---

<Base title={title} noindex>
  <SiteHeader showLogin />
  <main class="flex min-h-[calc(100dvh-6rem)] items-center justify-center px-4 py-12">
    <div class="glass-card w-full max-w-md rounded-3xl p-6 sm:p-8">
      <h1 class="text-2xl font-bold">{heading}</h1>
      <p class="mt-1 text-sm text-slate-400">{intro}</p>
      <slot />
    </div>
  </main>
  <SiteFooter />
</Base>
