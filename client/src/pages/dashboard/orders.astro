---
import Base from "../../layouts/Base.astro";
import DashboardNav from "../../components/DashboardNav.astro";
import { requireUser } from "../../lib/api";

const user = await requireUser(Astro);
if (!user) return Astro.redirect("/login");

const filters = [
  { value: "", label: "Semua" },
  { value: "PAID", label: "Dibayar" },
  { value: "PENDING", label: "Menunggu" },
  { value: "FAILED", label: "Gagal" },
];
---

<Base title="Pesanan | smart-storefront" noindex>
  <DashboardNav user={user} active="orders" />

  <main class="mx-auto max-w-6xl px-4 py-8">
    <h1 class="text-2xl font-bold">Riwayat transaksi</h1>
    <p class="mt-1 text-sm text-slate-400">Pembayaran lewat Midtrans. Status diperbarui otomatis dari notifikasi Midtrans.</p>

    <div class="mt-6 flex flex-wrap gap-2" role="group" aria-label="Filter status">
      {
        filters.map((f, i) => (
          <button
            type="button"
            data-filter={f.value}
            aria-pressed={i === 0 ? "true" : "false"}
            class="min-h-11 rounded-xl border border-white/10 px-4 text-sm font-medium text-slate-300 transition-colors hover:bg-white/[0.06] hover:text-white aria-pressed:border-white/25 aria-pressed:bg-white/10 aria-pressed:text-white"
          >
            {f.label}
          </button>
        ))
      }
    </div>

    <div id="orders" class="mt-6" aria-live="polite">
      <p data-state="loading" class="text-slate-400">Memuat pesanan...</p>

      <div data-state="error" hidden class="glass-card rounded-2xl p-6">
        <p id="error-text" class="text-rose-200">Pesanan tidak bisa dimuat.</p>
        <button type="button" id="retry" class="btn-ghost mt-4">Coba lagi</button>
      </div>

      <p data-state="empty" hidden class="glass-card rounded-2xl p-6 text-slate-300">
        Belum ada pesanan dengan status ini. Pesanan muncul di sini setelah pembeli menekan Bayar di halaman tokomu.
      </p>

      <div data-state="ready" hidden class="glass-card overflow-hidden rounded-2xl">
        <div class="md:overflow-x-auto">
          {/* Di layar kecil setiap baris tampil sebagai kartu berlabel, di md ke atas sebagai tabel. */}
          <table class="w-full text-left text-sm max-md:block md:min-w-[52rem]">
            <caption class="sr-only">Daftar pesanan, terbaru di atas</caption>
            <thead class="border-b border-white/10 bg-white/[0.03] text-slate-400 max-md:sr-only">
              <tr>
                <th scope="col" class="px-4 py-3 font-medium">Tanggal</th>
                <th scope="col" class="px-4 py-3 font-medium">Kode</th>
                <th scope="col" class="px-4 py-3 font-medium">Produk</th>
                <th scope="col" class="px-4 py-3 font-medium">Pembeli</th>
                <th scope="col" class="px-4 py-3 text-right font-medium">Total</th>
                <th scope="col" class="px-4 py-3 font-medium">Status</th>
              </tr>
            </thead>
            <tbody id="order-body" class="divide-y divide-white/10 max-md:block"></tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
</Base>

<script>
  import { errorMessage, formatRupiah } from "../../lib/api";
  import { api, formatDateTime, redirectIfUnauthorized, showState } from "../../lib/client";
  import { toast } from "../../lib/toast";
  import type { Order, OrderStatus } from "../../types/store";

  const root = document.querySelector<HTMLElement>("#orders")!;
  const body = document.querySelector<HTMLTableSectionElement>("#order-body")!;
  let status = "";

  // Status dibedakan dengan teks dan warna sekaligus, bukan warna saja.
  const BADGE: Record<OrderStatus, { label: string; cls: string }> = {
    PAID: { label: "PAID", cls: "border-emerald-400/30 bg-emerald-400/10 text-emerald-200" },
    PENDING: { label: "PENDING", cls: "border-amber-400/30 bg-amber-400/10 text-amber-200" },
    FAILED: { label: "FAILED", cls: "border-rose-400/30 bg-rose-400/10 text-rose-200" },
  };

  /** Label kolom ditampilkan lewat ::before hanya di mobile, saat header tabel disembunyikan. */
  const cell = (label: string, ...children: (string | Node)[]) => {
    const td = document.createElement("td");
    td.dataset.label = label;
    td.className =
      "px-4 py-3 align-top max-md:px-0 max-md:py-1 max-md:before:block max-md:before:text-xs max-md:before:text-slate-400 max-md:before:content-[attr(data-label)]";
    td.append(...children);
    return td;
  };
  const muted = (text: string) => {
    const span = document.createElement("span");
    span.className = "block text-xs text-slate-400 break-all";
    span.textContent = text;
    return span;
  };

  function row(order: Order) {
    const tr = document.createElement("tr");
    tr.className = "transition-colors hover:bg-white/[0.03] max-md:grid max-md:grid-cols-2 max-md:gap-x-4 max-md:gap-y-2 max-md:p-4";

    const product = document.createElement("span");
    product.className = "block text-slate-100";
    product.textContent = order.itemTitle;
    const buyer = document.createElement("span");
    buyer.className = "block text-slate-100";
    buyer.textContent = order.buyerName;

    const badge = document.createElement("span");
    badge.className = `inline-flex rounded-full border px-2.5 py-0.5 text-xs font-semibold tracking-wide ${BADGE[order.status].cls}`;
    badge.textContent = BADGE[order.status].label;

    const total = cell(
      "Total",
      formatRupiah(order.grossAmount),
      ...(order.couponCode ? [muted(`${order.couponCode} -${formatRupiah(order.discountAmount ?? 0)}`)] : []),
    );
    total.classList.add("md:text-right", "tabular-nums", "text-slate-100");

    tr.append(
      cell("Tanggal", formatDateTime(order.createdAt)),
      cell("Kode", order.orderCode),
      cell(
        "Produk",
        product,
        muted(`${order.quantity} pcs`),
        ...(order.digitalFileName ? [muted(`File: ${order.digitalFileName} (diunduh ${order.downloadCount ?? 0}x)`)] : []),
        ...(order.note ? [muted(`Catatan: ${order.note}`)] : []),
      ),
      cell("Pembeli", buyer, muted(order.buyerEmail)),
      total,
      cell("Status", badge, ...(order.paymentType ? [muted(order.paymentType.replace(/_/g, " "))] : [])),
    );
    return order.shippingAddress ? [tr, shippingRow(order)] : [tr];
  }

  /** Baris tambahan untuk barang fisik: alamat tujuan dan input nomor resi. */
  function shippingRow(order: Order) {
    const tr = document.createElement("tr");
    // Tanpa garis pemisah agar menyatu dengan baris pesanannya.
    tr.className = "!border-t-0 max-md:block max-md:px-4 max-md:pb-4";
    const td = document.createElement("td");
    td.colSpan = 6;
    td.className = "px-4 pb-4 max-md:block max-md:p-0";
    tr.append(td);

    const box = document.createElement("div");
    box.className = "grid gap-3 rounded-xl border border-white/10 bg-white/[0.03] p-3 md:grid-cols-[minmax(0,1fr)_minmax(0,22rem)]";
    td.append(box);

    const address = document.createElement("div");
    address.className = "min-w-0 text-sm";
    const heading = document.createElement("p");
    heading.className = "text-xs font-medium text-slate-400";
    heading.textContent = "Kirim ke";
    const addr = document.createElement("p");
    addr.className = "mt-0.5 whitespace-pre-line text-slate-100 break-words";
    addr.textContent = `${order.buyerName}\n${order.shippingAddress}`;
    const phone = document.createElement("a");
    phone.className = "mt-1 inline-flex min-h-11 items-center text-indigo-300 underline-offset-4 hover:underline";
    phone.href = `https://wa.me/${(order.shippingPhone ?? "").replace(/^0/, "62").replace(/^\+/, "")}`;
    phone.target = "_blank";
    phone.rel = "noopener";
    phone.textContent = `WhatsApp ${order.shippingPhone ?? "-"}`;
    address.append(heading, addr, phone);
    box.append(address);

    if (order.status !== "PAID") {
      box.append(muted("Nomor resi bisa diisi setelah pesanan lunas."));
      return tr;
    }

    const form = document.createElement("form");
    form.className = "self-start";
    form.noValidate = true;
    const id = `tracking-${order.id}`;
    form.innerHTML = `
      <label for="${id}" class="label text-xs">Nomor resi pengiriman</label>
      <div class="mt-1 flex gap-2">
        <input id="${id}" name="trackingNumber" maxlength="60" placeholder="JNE 0123456789" class="glass-input min-w-0 text-sm" />
        <button type="submit" class="btn-ghost shrink-0 px-4 text-sm">Simpan</button>
      </div>
      <p class="mt-1.5 text-xs text-slate-400" data-tracking-status></p>`;
    const input = form.querySelector<HTMLInputElement>("input")!;
    const button = form.querySelector<HTMLButtonElement>("button")!;
    const statusEl = form.querySelector<HTMLElement>("[data-tracking-status]")!;
    input.value = order.trackingNumber ?? "";
    statusEl.textContent = order.shippedAt ? `Dikirim ${formatDateTime(order.shippedAt)}. Pembeli melihat resi di struknya.` : "Pembeli dikabari lewat email saat resi disimpan.";

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      button.disabled = true;
      button.textContent = "Menyimpan...";
      try {
        const res = await api(`/orders/${order.id}/tracking`, {
          method: "PATCH",
          body: JSON.stringify({ trackingNumber: input.value.trim() || null }),
        });
        if (redirectIfUnauthorized(res)) return;
        if (!res.ok) throw new Error(await errorMessage(res, "Nomor resi gagal disimpan."));
        const { order: saved } = (await res.json()) as { order: Pick<Order, "trackingNumber" | "shippedAt"> };
        order.trackingNumber = saved.trackingNumber;
        order.shippedAt = saved.shippedAt;
        statusEl.textContent = saved.shippedAt ? `Dikirim ${formatDateTime(saved.shippedAt)}. Pembeli melihat resi di struknya.` : "Resi dihapus.";
        toast(saved.trackingNumber ? `Resi ${saved.trackingNumber} disimpan.` : "Nomor resi dihapus.");
      } catch (err) {
        toast(err instanceof TypeError ? "Tidak bisa terhubung ke server." : (err as Error).message, "error");
      } finally {
        button.disabled = false;
        button.textContent = "Simpan";
      }
    });
    box.append(form);
    return tr;
  }

  async function load() {
    showState(root, "loading");
    try {
      const res = await api(`/orders${status ? `?status=${status}` : ""}`);
      if (redirectIfUnauthorized(res)) return;
      if (!res.ok) throw new Error(await errorMessage(res, "Pesanan tidak bisa dimuat."));
      const { orders } = (await res.json()) as { orders: Order[] };
      body.replaceChildren(...orders.flatMap(row));
      showState(root, orders.length ? "ready" : "empty");
    } catch (err) {
      document.querySelector("#error-text")!.textContent =
        err instanceof TypeError ? "Tidak bisa terhubung ke server." : (err as Error).message;
      showState(root, "error");
    }
  }

  document.querySelectorAll<HTMLButtonElement>("[data-filter]").forEach((button) => {
    button.addEventListener("click", () => {
      status = button.dataset.filter ?? "";
      document
        .querySelectorAll<HTMLButtonElement>("[data-filter]")
        .forEach((b) => b.setAttribute("aria-pressed", String(b === button)));
      void load();
    });
  });
  document.querySelector("#retry")!.addEventListener("click", () => void load());
  void load();
</script>
