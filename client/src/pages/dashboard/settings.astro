---
import Base from "../../layouts/Base.astro";
import DashboardNav from "../../components/DashboardNav.astro";
import { requireUser, siteHost } from "../../lib/api";
import { safeHex } from "../../lib/color";

const user = await requireUser(Astro);
if (!user) return Astro.redirect("/login");

const theme = safeHex(user.themeColor);
const initials = user.displayName
  .split(/\s+/)
  .slice(0, 2)
  .map((w) => w[0]?.toUpperCase() ?? "")
  .join("");
const platforms = ["Instagram", "TikTok", "WhatsApp", "Shopee", "Tokopedia", "YouTube", "Facebook", "X", "Lainnya"];
---

<Base title="Pengaturan | smart-storefront" noindex>
  <DashboardNav user={user} active="settings" />

  <main class="mx-auto max-w-3xl px-4 py-8">
    <h1 class="text-2xl font-bold">Pengaturan toko</h1>
    <p class="mt-1 text-sm text-slate-400">
      Tampil di <a href={`/${user.username}`} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center text-indigo-300 underline-offset-4 hover:underline"
        >{siteHost(Astro.site, Astro.url)}/{user.username}<span class="sr-only"> (tab baru)</span></a
      >
    </p>

    <form
      id="profile-form"
      class="glass-card mt-6 space-y-8 rounded-2xl p-5 sm:p-8"
      novalidate
      data-socials={JSON.stringify(user.socialLinks ?? [])}
    >
      <section aria-labelledby="avatar-heading">
        <h2 id="avatar-heading" class="text-lg font-bold">Foto profil</h2>
        <div class="mt-4 flex flex-wrap items-center gap-5">
          <div id="avatar-ring" class="rounded-full p-1" style={`background:${theme}`}>
            <img
              id="avatar-img"
              src={user.avatarUrl ?? undefined}
              alt="Foto profil saat ini"
              width="88"
              height="88"
              class="size-[88px] rounded-full border-4 border-night bg-night-raised object-cover"
              hidden={!user.avatarUrl}
            />
            <div
              id="avatar-initials"
              class="flex size-[88px] items-center justify-center rounded-full border-4 border-night bg-night-raised font-display text-2xl font-bold text-white"
              aria-hidden="true"
              hidden={Boolean(user.avatarUrl)}
            >
              {initials}
            </div>
          </div>
          <div class="flex flex-wrap gap-2">
            <label for="avatar-file" class="btn-ghost has-[:focus-visible]:outline has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-indigo-300">
              <span id="avatar-label">{user.avatarUrl ? "Ganti foto" : "Unggah foto"}</span>
              <input id="avatar-file" type="file" accept="image/jpeg,image/png,image/webp" class="sr-only" />
            </label>
            <button type="button" id="avatar-remove" class="btn-ghost" hidden={!user.avatarUrl}>Hapus foto</button>
          </div>
        </div>
        <p class="mt-2 text-xs text-slate-400">JPG, PNG, atau WebP, maks. 2 MB. Foto persegi tampil paling rapi.</p>
        <input type="hidden" name="avatarUrl" id="avatar-url" value={user.avatarUrl ?? ""} />
      </section>

      <section aria-labelledby="identity-heading" class="space-y-4">
        <h2 id="identity-heading" class="text-lg font-bold">Identitas</h2>
        <div>
          <label for="display-name" class="label">Nama toko</label>
          <input id="display-name" name="displayName" required maxlength="60" value={user.displayName} class="glass-input mt-1" />
        </div>
        <div>
          <div class="flex items-baseline justify-between">
            <label for="bio" class="label">Bio</label>
            <span id="bio-count" class="text-xs tabular-nums text-slate-400" aria-live="polite"></span>
          </div>
          <textarea id="bio" name="bio" rows="3" maxlength="250" class="glass-input mt-1 py-2.5" aria-describedby="bio-count">{user.bio ?? ""}</textarea>
        </div>
      </section>

      <section aria-labelledby="color-heading">
        <h2 id="color-heading" class="text-lg font-bold">Warna aksen</h2>
        <p class="mt-1 text-sm text-slate-400">Dipakai untuk cincin foto profil di halaman toko.</p>
        <div class="mt-3 flex flex-wrap items-center gap-3">
          <label for="theme-picker" class="sr-only">Pilih warna</label>
          <input id="theme-picker" type="color" value={theme} class="h-11 w-16 rounded-xl border border-white/15 bg-transparent p-1" />
          <label for="theme-hex" class="sr-only">Kode warna hex</label>
          <input
            id="theme-hex"
            name="themeColor"
            value={theme}
            required
            maxlength="7"
            pattern="#[0-9a-fA-F]{6}"
            spellcheck="false"
            class="glass-input w-32 font-mono uppercase"
          />
        </div>
        <p id="contrast-warning" class="mt-2 text-sm text-amber-200" hidden>
          Warna ini terlalu gelap untuk latar halaman toko, jadi halaman toko memakai indigo sebagai gantinya.
        </p>
      </section>

      <section aria-labelledby="social-heading">
        <h2 id="social-heading" class="text-lg font-bold">Tautan sosial</h2>
        <p class="mt-1 text-sm text-slate-400">Tampil di bawah bio. Maksimal 8.</p>
        <ul id="social-list" class="mt-3 space-y-3"></ul>
        <button type="button" id="social-add" class="btn-ghost mt-3 text-sm">Tambah tautan sosial</button>

        <template id="social-template">
          <li class="grid grid-cols-[minmax(0,1fr)_auto] items-end gap-2 sm:grid-cols-[minmax(0,9rem)_minmax(0,1fr)_auto]">
            <div>
              <label class="label text-xs" data-for="platform">Platform</label>
              <select data-field="platform" class="glass-input mt-1 bg-night-raised px-2 text-sm">
                {platforms.map((p) => <option value={p}>{p}</option>)}
              </select>
            </div>
            <div class="max-sm:col-span-2 max-sm:row-start-2">
              <label class="label text-xs" data-for="url">URL</label>
              <input data-field="url" type="url" inputmode="url" required placeholder="https://" class="glass-input mt-1 text-sm" />
            </div>
            <button type="button" data-action="remove" class="btn-ghost size-11 px-0 text-lg max-sm:col-start-2 max-sm:row-start-1">
              <span aria-hidden="true">&times;</span>
            </button>
          </li>
        </template>
      </section>

      <div class="flex flex-wrap items-center gap-3 border-t border-white/10 pt-6">
        <button type="submit" id="save" class="btn-glow rounded-xl px-6">Simpan perubahan</button>
        <p id="form-error" role="alert" class="text-sm text-rose-200"></p>
      </div>
    </form>

    <h2 class="mt-12 text-xl font-bold">Akun</h2>
    <p class="mt-1 text-sm text-slate-400">Masuk sebagai {user.email}</p>

    <form id="password-form" class="glass-card mt-4 space-y-4 rounded-2xl p-5 sm:p-8" novalidate aria-labelledby="password-heading">
      <h3 id="password-heading" class="text-lg font-bold">Ganti password</h3>
      <div>
        <label for="current-password" class="label">Password saat ini</label>
        <input id="current-password" type="password" autocomplete="current-password" required class="glass-input mt-1" />
      </div>
      <div>
        <label for="new-password" class="label">Password baru</label>
        <input id="new-password" type="password" autocomplete="new-password" required minlength="8" aria-describedby="new-password-hint" class="glass-input mt-1" />
        <p id="new-password-hint" class="mt-1.5 text-sm text-slate-400">Minimal 8 karakter.</p>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <button type="submit" class="btn-ghost">Ganti password</button>
        <p role="alert" data-error class="text-sm text-rose-200"></p>
      </div>
    </form>

    <section aria-labelledby="danger-heading" class="mt-6 rounded-2xl border border-rose-400/30 bg-rose-500/[0.06] p-5 sm:p-8">
      <h3 id="danger-heading" class="text-lg font-bold">Zona berbahaya</h3>
      <p class="mt-2 text-sm text-slate-300">
        Menghapus akun menghapus halaman <span class="font-medium text-white">/{user.username}</span>, semua produk, riwayat pesanan, kode promo,
        analitik, riwayat pencairan, dan file produk digital secara permanen. Saldo yang belum dicairkan ikut hilang. Pembeli lama tidak bisa lagi
        membuka struk atau mengunduh file. Tidak bisa dibatalkan.
      </p>
      <button
        type="button"
        id="delete-open"
        class="mt-4 inline-flex min-h-11 items-center justify-center rounded-xl border border-rose-400/40 px-5 font-semibold text-rose-100 transition-colors hover:bg-rose-500/15 active:translate-y-px"
      >
        Hapus akun permanen
      </button>
    </section>

    <dialog
      id="delete-dialog"
      aria-labelledby="delete-heading"
      class="m-auto max-h-[calc(100dvh-2rem)] w-[calc(100%-2rem)] max-w-md overflow-y-auto bg-transparent p-0 text-slate-200 backdrop:bg-black/70 backdrop:backdrop-blur-md"
    >
      <form id="delete-form" class="dialog-panel glass-card space-y-4 rounded-3xl border-rose-400/30 bg-night-raised/80 p-6" novalidate>
        <h3 id="delete-heading" class="text-xl font-bold">Hapus akun permanen?</h3>
        <p class="text-sm text-slate-300">Semua data toko <span class="font-medium text-white">/{user.username}</span> akan hilang dan tidak bisa dipulihkan.</p>
        <div>
          <label for="delete-confirm" class="label">Ketik username <span class="font-mono text-white">{user.username}</span> untuk konfirmasi</label>
          <input id="delete-confirm" autocomplete="off" autocapitalize="none" spellcheck="false" required pattern={user.username} class="glass-input mt-1" />
        </div>
        <div>
          <label for="delete-password" class="label">Password saat ini</label>
          <input id="delete-password" type="password" autocomplete="current-password" required class="glass-input mt-1" />
        </div>
        <p role="alert" data-error class="text-sm text-rose-200"></p>
        <div class="grid gap-2 sm:grid-cols-2">
          <button type="submit" class="inline-flex min-h-11 items-center justify-center rounded-xl bg-rose-700 px-5 font-semibold text-white transition-colors hover:bg-rose-600 active:translate-y-px disabled:opacity-50 sm:order-2">
            Hapus akun
          </button>
          <button type="button" id="delete-cancel" class="btn-ghost sm:order-1">Batal</button>
        </div>
      </form>
    </dialog>
  </main>
</Base>

<script>
  import { errorMessage } from "../../lib/api";
  import { api, redirectIfUnauthorized, uploadImage } from "../../lib/client";
  import { toast } from "../../lib/toast";
  import type { SocialLink, UserProfile } from "../../types/store";

  const $ = <T extends Element>(selector: string) => document.querySelector<T>(selector)!;
  const form = $<HTMLFormElement>("#profile-form");
  const save = $<HTMLButtonElement>("#save");
  const formError = $<HTMLElement>("#form-error");

  // --- Foto profil
  const avatarImg = $<HTMLImageElement>("#avatar-img");
  const avatarInitials = $<HTMLElement>("#avatar-initials");
  const avatarUrl = $<HTMLInputElement>("#avatar-url");
  const avatarFile = $<HTMLInputElement>("#avatar-file");
  const avatarRemove = $<HTMLButtonElement>("#avatar-remove");
  const avatarLabel = $<HTMLElement>("#avatar-label");

  function showAvatar(url: string) {
    avatarUrl.value = url;
    avatarImg.hidden = !url;
    avatarInitials.hidden = Boolean(url);
    avatarRemove.hidden = !url;
    avatarLabel.textContent = url ? "Ganti foto" : "Unggah foto";
    if (url) avatarImg.src = url;
  }

  avatarFile.addEventListener("change", async () => {
    const file = avatarFile.files?.[0];
    if (!file) return;
    save.disabled = true;
    avatarLabel.textContent = "Mengunggah...";
    try {
      showAvatar(await uploadImage(file));
      toast("Foto terunggah. Tekan Simpan perubahan untuk memakainya.");
    } catch (err) {
      avatarLabel.textContent = avatarUrl.value ? "Ganti foto" : "Unggah foto";
      toast((err as Error).message, "error");
    } finally {
      avatarFile.value = "";
      save.disabled = false;
    }
  });
  avatarRemove.addEventListener("click", () => showAvatar(""));

  // --- Bio
  const bio = $<HTMLTextAreaElement>("#bio");
  const bioCount = $<HTMLElement>("#bio-count");
  const updateCount = () => (bioCount.textContent = `${bio.value.length}/250`);
  bio.addEventListener("input", updateCount);
  updateCount();

  // --- Warna aksen: color picker dan input hex saling sinkron
  const picker = $<HTMLInputElement>("#theme-picker");
  const hex = $<HTMLInputElement>("#theme-hex");
  const ring = $<HTMLElement>("#avatar-ring");
  const warning = $<HTMLElement>("#contrast-warning");
  const HEX = /^#[0-9a-f]{6}$/i;

  const luminance = (h: string) => {
    const n = Number.parseInt(h.slice(1), 16);
    const [r, g, b] = [(n >> 16) & 255, (n >> 8) & 255, n & 255].map((c) => {
      const s = c / 255;
      return s <= 0.03928 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4;
    }) as [number, number, number];
    return 0.2126 * r + 0.7152 * g + 0.0722 * b;
  };
  // Sama dengan aturan accentOnDark di halaman toko: kontras minimal 3:1 terhadap #070913.
  const tooDark = (h: string) => (luminance(h) + 0.05) / (luminance("#070913") + 0.05) < 3;

  function applyColor(value: string) {
    if (!HEX.test(value)) return;
    ring.style.background = tooDark(value) ? "#818cf8" : value;
    warning.hidden = !tooDark(value);
  }
  picker.addEventListener("input", () => {
    hex.value = picker.value;
    applyColor(picker.value);
  });
  hex.addEventListener("input", () => {
    if (HEX.test(hex.value)) picker.value = hex.value.toLowerCase();
    applyColor(hex.value);
  });
  applyColor(hex.value);

  // --- Tautan sosial
  const list = $<HTMLUListElement>("#social-list");
  const template = $<HTMLTemplateElement>("#social-template");
  const addSocial = $<HTMLButtonElement>("#social-add");
  let rowId = 0;

  function addRow(link?: SocialLink) {
    const node = template.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
    const id = `social-${rowId++}`;
    const select = node.querySelector<HTMLSelectElement>('[data-field="platform"]')!;
    const url = node.querySelector<HTMLInputElement>('[data-field="url"]')!;
    select.id = `${id}-platform`;
    url.id = `${id}-url`;
    node.querySelector('[data-for="platform"]')!.setAttribute("for", select.id);
    node.querySelector('[data-for="url"]')!.setAttribute("for", url.id);
    if (link) {
      // Platform lama yang tidak ada di daftar tetap dipertahankan sebagai opsi.
      if (![...select.options].some((o) => o.value === link.platform)) select.add(new Option(link.platform, link.platform));
      select.value = link.platform;
      url.value = link.url;
    }
    const remove = node.querySelector<HTMLButtonElement>('[data-action="remove"]')!;
    remove.addEventListener("click", () => {
      node.remove();
      syncAdd();
      addSocial.focus();
    });
    list.append(node);
    syncAdd();
    updateRemoveLabels();
    return node;
  }
  function updateRemoveLabels() {
    list.querySelectorAll("li").forEach((li, i) => {
      li.querySelector('[data-action="remove"]')!.setAttribute("aria-label", `Hapus tautan sosial ${i + 1}`);
    });
  }
  function syncAdd() {
    addSocial.disabled = list.children.length >= 8;
    updateRemoveLabels();
  }
  addSocial.addEventListener("click", () => addRow().querySelector("select")!.focus());
  (JSON.parse(form.dataset.socials ?? "[]") as SocialLink[]).forEach((l) => addRow(l));

  // --- Simpan
  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    formError.textContent = "";
    if (!form.checkValidity()) {
      const invalid = form.querySelector<HTMLInputElement>("input:invalid, textarea:invalid, select:invalid");
      const label = invalid ? form.querySelector(`label[for="${invalid.id}"]`)?.textContent?.trim() : null;
      formError.textContent = label ? `Periksa "${label}". ${invalid?.validationMessage ?? ""}` : "Periksa isian form.";
      invalid?.focus();
      return;
    }

    const payload = {
      displayName: $<HTMLInputElement>("#display-name").value.trim(),
      bio: bio.value,
      avatarUrl: avatarUrl.value,
      themeColor: hex.value.toLowerCase(),
      socialLinks: [...list.querySelectorAll("li")].map((li) => ({
        platform: li.querySelector<HTMLSelectElement>('[data-field="platform"]')!.value,
        url: li.querySelector<HTMLInputElement>('[data-field="url"]')!.value.trim(),
      })),
    };

    save.disabled = true;
    save.textContent = "Menyimpan...";
    try {
      const res = await api("/auth/profile", { method: "PUT", body: JSON.stringify(payload) });
      if (redirectIfUnauthorized(res)) return;
      if (!res.ok) {
        const message = await errorMessage(res, "Gagal menyimpan profil.");
        formError.textContent = message;
        toast(message, "error");
        return;
      }
      const { user } = (await res.json()) as { user: UserProfile };
      document.querySelectorAll("[data-store-name]").forEach((el) => (el.textContent = user.displayName));
      toast("Profil tersimpan. Halaman tokomu sudah diperbarui.");
    } catch {
      formError.textContent = "Tidak bisa terhubung ke server.";
      toast("Tidak bisa terhubung ke server.", "error");
    } finally {
      save.disabled = false;
      save.textContent = "Simpan perubahan";
    }
  });

  /** Form akun kecil: validasi bawaan browser, kirim, tampilkan error di [data-error]. */
  function accountForm(
    form: HTMLFormElement,
    busyLabel: string,
    request: () => Promise<Response>,
    onDone: () => void,
    invalidMessage?: (el: HTMLInputElement) => string | undefined,
  ) {
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
    const error = form.querySelector<HTMLElement>("[data-error]")!;
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      error.textContent = "";
      if (!form.checkValidity()) {
        const invalid = form.querySelector<HTMLInputElement>("input:invalid, textarea:invalid, select:invalid")!;
        const label = form.querySelector(`label[for="${invalid.id}"]`)?.textContent?.trim();
        error.textContent = invalidMessage?.(invalid) ?? `Periksa "${label}". ${invalid.validationMessage}`;
        invalid.focus();
        return;
      }
      const original = button.textContent;
      button.disabled = true;
      button.textContent = busyLabel;
      try {
        const res = await request();
        if (redirectIfUnauthorized(res)) return;
        if (!res.ok) {
          error.textContent = await errorMessage(res, "Gagal memproses. Coba lagi.");
          return;
        }
        onDone();
      } catch {
        error.textContent = "Tidak bisa terhubung ke server.";
      } finally {
        button.disabled = false;
        button.textContent = original;
      }
    });
  }

  const passwordForm = $<HTMLFormElement>("#password-form");
  accountForm(
    passwordForm,
    "Menyimpan...",
    () =>
      api("/auth/password", {
        method: "PUT",
        body: JSON.stringify({
          currentPassword: $<HTMLInputElement>("#current-password").value,
          newPassword: $<HTMLInputElement>("#new-password").value,
        }),
      }),
    () => {
      passwordForm.reset();
      toast("Password berhasil diganti.");
    },
  );

  // Hapus akun: tombol di Zona berbahaya membuka modal konfirmasi (username + password).
  const deleteDialog = $<HTMLDialogElement>("#delete-dialog");
  const deleteForm = $<HTMLFormElement>("#delete-form");
  const deleteOpen = $<HTMLButtonElement>("#delete-open");
  deleteOpen.addEventListener("click", () => {
    deleteForm.reset();
    deleteForm.querySelector<HTMLElement>("[data-error]")!.textContent = "";
    deleteDialog.showModal();
    $<HTMLInputElement>("#delete-confirm").focus();
  });
  $("#delete-cancel").addEventListener("click", () => deleteDialog.close());
  deleteDialog.addEventListener("click", (e) => {
    if (e.target === deleteDialog) deleteDialog.close();
  });
  deleteDialog.addEventListener("close", () => deleteOpen.focus());

  accountForm(
    deleteForm,
    "Menghapus...",
    () => api("/auth/account", { method: "DELETE", body: JSON.stringify({ password: $<HTMLInputElement>("#delete-password").value }) }),
    () => location.assign("/"),
    (el) => (el.id === "delete-confirm" ? "Username yang diketik belum sama." : undefined),
  );
</script>
