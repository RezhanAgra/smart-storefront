---
import QRCode from "qrcode";
import Base from "../../layouts/Base.astro";
import DashboardNav from "../../components/DashboardNav.astro";
import { requireUser } from "../../lib/api";

const user = await requireUser(Astro);
if (!user) return Astro.redirect("/login");

const storeUrl = new URL(`/${user.username}`, Astro.site ?? Astro.url).href;
// Hitam di atas putih dengan margin cukup: paling mudah dipindai kamera HP, juga setelah dicetak.
const options = { errorCorrectionLevel: "M", margin: 2, color: { dark: "#000000", light: "#ffffff" } } as const;
const svg = await QRCode.toString(storeUrl, { ...options, type: "svg" });
const png = await QRCode.toDataURL(storeUrl, { ...options, width: 1024 });
const svgHref = `data:image/svg+xml;charset=utf-8,${encodeURIComponent(svg)}`;
---

<Base title="QR Kasir | smart-storefront" noindex>
  <div class="print:hidden"><DashboardNav user={user} active="qr" /></div>

  <main class="mx-auto max-w-4xl px-4 py-8 print:p-0">
    <div class="print:hidden">
      <h1 class="text-2xl font-bold">QR Code kasir</h1>
      <p class="mt-1 text-sm text-slate-400">
        Tempel di meja kasir atau kemasan. Pembeli memindai, lalu langsung membuka halaman tokomu.
      </p>
    </div>

    <div class="mt-6 grid items-start gap-6 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] print:mt-0 print:block">
      {/* Poster: satu-satunya bagian yang ikut tercetak. */}
      <section
        id="poster"
        aria-labelledby="poster-title"
        class="mx-auto w-full max-w-sm rounded-3xl bg-white p-6 text-center text-slate-900 shadow-[0_25px_70px_-20px_rgba(79,70,229,0.45)] print:max-w-none print:shadow-none"
      >
        <p class="text-sm font-medium text-slate-500">Scan untuk lihat katalog dan bayar</p>
        <h2 id="poster-title" class="mt-1 font-display text-2xl font-extrabold text-slate-900 break-words">{user.displayName}</h2>
        <div class="mx-auto mt-4 aspect-square w-full max-w-[260px] [&>svg]:h-full [&>svg]:w-full" role="img" aria-label={`QR code menuju ${storeUrl}`}>
          <Fragment set:html={svg} />
        </div>
        <p class="mt-4 font-mono text-sm font-semibold text-slate-700 break-all">{storeUrl.replace(/^https?:\/\//, "")}</p>
      </section>

      <div class="glass-card rounded-2xl p-5 sm:p-6 print:hidden">
        <h2 class="text-lg font-bold">Pakai QR ini</h2>
        <dl class="mt-3 text-sm">
          <dt class="text-slate-400">Tujuan</dt>
          <dd class="mt-0.5">
            <a href={`/${user.username}`} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center break-all text-indigo-300 underline-offset-4 hover:underline">
              {storeUrl}<span class="sr-only"> (tab baru)</span>
            </a>
          </dd>
        </dl>
        <div class="mt-4 grid gap-2">
          <button type="button" id="print" class="btn-glow rounded-xl">Cetak poster</button>
          <a href={png} download={`qr-${user.username}.png`} class="btn-ghost">Unduh PNG (1024 px)</a>
          <a href={svgHref} download={`qr-${user.username}.svg`} class="btn-ghost">Unduh SVG (untuk desain/percetakan)</a>
        </div>
        <p class="mt-4 text-xs text-slate-400">
          QR ini selalu mengarah ke alamat yang sama, jadi tetap berlaku walau isi toko berubah. Jika username berganti, cetak ulang.
        </p>
      </div>
    </div>
  </main>
</Base>

<script>
  document.querySelector("#print")?.addEventListener("click", () => window.print());
</script>
