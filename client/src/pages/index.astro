---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { siteHost } from "../lib/api";

const host = siteHost(Astro.site, Astro.url);

// Hanya fitur yang benar-benar ada di aplikasi ini.
const features = [
  {
    title: "Tautan dan katalog di satu halaman",
    body: "Gabungkan link Instagram, WhatsApp, atau marketplace dengan kartu produk berharga Rupiah dan sisa stok.",
    icon: "M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1",
  },
  {
    title: "Pembeli bayar lewat Midtrans",
    body: "Tombol Beli membuka checkout Midtrans Snap. Stok berkurang otomatis setelah pembayaran lunas.",
    icon: "M3 7h18v10H3zM3 11h18M7 15h3",
  },
  {
    title: "Analitik dan riwayat pesanan",
    body: "Lihat kunjungan, klik per item, pendapatan harian, dan status setiap transaksi dari dashboard.",
    icon: "M4 19V5M4 19h16M8 15l3-4 3 2 5-6",
  },
];
---

<Base
  title="smart-storefront: link-in-bio dan etalase produk untuk UMKM"
  description="Satu link di bio untuk semua akun dan produkmu. Pembeli lihat harga dan stok, lalu bayar lewat Midtrans."
>
  <SiteHeader showLogin />

  <main>
    <section class="mx-auto grid max-w-5xl items-center gap-12 px-5 pb-16 pt-16 md:grid-cols-[1.1fr_0.9fr] md:pt-24">
      <div>
        <h1 class="text-4xl font-extrabold leading-[1.1] sm:text-5xl lg:text-6xl">
          Satu link di bio, langsung jadi toko.
        </h1>
        <p class="mt-5 max-w-lg text-lg leading-relaxed text-slate-300">
          Pasang di bio Instagram atau TikTok. Pembeli melihat produk, harga, dan stok, lalu membayar tanpa pindah aplikasi.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="/login?mode=register" class="btn-glow rounded-xl px-6 text-base">Buat halaman tokomu</a>
          <a href="/login" class="btn-ghost px-5">Sudah punya akun? Masuk</a>
        </div>
        <p class="mt-6 text-sm text-slate-400">
          Alamat tokomu nanti: <span class="font-medium text-slate-200">{host}/namatokomu</span>
        </p>
      </div>

      <figure class="mx-auto w-full max-w-sm">
        {/* Ilustrasi, bukan toko sungguhan: semua isinya placeholder dan tidak bisa diklik. */}
        <div class="glass-card pointer-events-none select-none rounded-3xl p-6" aria-hidden="true">
          <div class="mx-auto w-fit rounded-full bg-indigo-400 p-1">
            <div class="flex size-20 items-center justify-center rounded-full border-4 border-night bg-night-raised font-display text-2xl font-bold text-white">
              NT
            </div>
          </div>
          <p class="mt-4 text-center font-display text-xl font-bold text-white">Nama Tokomu</p>
          <p class="mt-2 text-center">
            <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs text-slate-300">@namatokomu</span>
          </p>
          <div class="mt-6 space-y-3">
            <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-3.5 text-sm font-semibold text-white">
              Tautan ke Instagram
            </div>
            <div class="flex gap-3 rounded-2xl border border-white/10 bg-white/[0.04] p-3.5">
              <div class="size-14 shrink-0 rounded-xl border border-white/10 bg-white/5"></div>
              <div class="min-w-0 flex-1">
                <p class="text-sm font-semibold text-white">Produk pertamamu</p>
                <p class="mt-1 text-sm font-bold text-emerald-300">Rp 75.000</p>
                <p class="text-xs text-slate-400">Stok: 12</p>
              </div>
            </div>
          </div>
        </div>
        <figcaption class="mt-3 text-center text-sm text-slate-400">Contoh tampilan halaman toko</figcaption>
      </figure>
    </section>

    <section aria-labelledby="features-heading" class="mx-auto max-w-5xl px-5 pb-20">
      <h2 id="features-heading" class="text-2xl font-bold">Yang kamu dapat</h2>
      <ul class="mt-6 grid gap-4 md:grid-cols-3">
        {
          features.map((f) => (
            <li class="glass-card rounded-2xl p-6">
              <span
                class="flex size-11 items-center justify-center rounded-xl border border-indigo-300/20 bg-indigo-400/10 text-indigo-200"
                aria-hidden="true"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5">
                  <path d={f.icon} />
                </svg>
              </span>
              <h3 class="mt-4 text-lg font-bold">{f.title}</h3>
              <p class="mt-2 leading-relaxed text-slate-300">{f.body}</p>
            </li>
          ))
        }
      </ul>
    </section>
  </main>

  <SiteFooter />
</Base>
