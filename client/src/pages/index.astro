---
import QRCode from "qrcode";
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

// QR di kartu analitik adalah QR asli menuju toko demo, bukan gambar hiasan.
const demoUrl = new URL("/demo", Astro.site ?? Astro.url).href;
const demoQr = await QRCode.toString(demoUrl, {
  type: "svg",
  margin: 1,
  errorCorrectionLevel: "M",
  color: { dark: "#0b0d17", light: "#ffffff" },
});

// Tinggi batang grafik mini: bentuk ilustrasi saja, tanpa angka.
const bars = [38, 52, 44, 66, 58, 80, 72];
---

<Base
  title="SmartStorefront: satu link di bio, langsung jadi toko"
  description="Halaman link-in-bio dengan katalog produk, kode promo, produk digital, dan pembayaran Midtrans untuk kreator dan UMKM."
>
  <SiteHeader showLogin showCta />

  <main>
    {/* Hero: klaim username di kiri, pratinjau ponsel yang ikut berubah di kanan. */}
    <section class="mx-auto grid max-w-5xl items-center gap-14 px-5 pb-20 pt-14 md:grid-cols-[1.05fr_0.95fr] md:pt-20">
      <div>
        <p class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.04] px-3 py-1 text-xs font-medium text-slate-300">
          <span class="size-1.5 rounded-full bg-emerald-400" aria-hidden="true"></span>
          Siap dalam 60 detik · Terintegrasi Midtrans
        </p>

        <h1 class="mt-5 text-4xl font-extrabold leading-[1.1] tracking-tight sm:text-6xl">
          <span class="block">Satu link di bio,</span>
          <span class="block text-indigo-200">langsung jadi toko.</span>
        </h1>
        <p class="mt-5 max-w-lg text-lg leading-relaxed text-slate-300">
          Pasang di bio Instagram atau TikTok. Pembeli melihat produk, memakai kode promo, lalu membayar lewat Midtrans tanpa
          pindah aplikasi.
        </p>

        {/* Tanpa JavaScript pun form ini bekerja: membuka form daftar dengan username terisi. */}
        <form action="/login" method="get" class="mt-8 max-w-xl" id="claim-form">
          <input type="hidden" name="mode" value="register" />
          <label for="claim-username" class="sr-only">Nama tokomu (huruf kecil dan angka)</label>
          <div class="flex flex-col gap-2 rounded-2xl border border-white/15 bg-white/[0.05] p-1.5 backdrop-blur-xl focus-within:border-indigo-300/50 focus-within:ring-2 focus-within:ring-indigo-300/60 sm:flex-row sm:items-center">
            <div class="flex min-w-0 flex-1 items-center pl-3">
              <span class="shrink-0 font-medium text-slate-400" aria-hidden="true">smartstore.id/@</span>
              <input
                id="claim-username"
                name="username"
                autocomplete="off"
                autocapitalize="none"
                spellcheck="false"
                maxlength="30"
                placeholder="namatokomu"
                class="min-h-11 w-full min-w-0 bg-transparent px-1 text-base font-medium text-white placeholder:text-slate-400 outline-hidden"
              />
            </div>
            <button type="submit" class="btn-glow rounded-xl px-5">Buat Toko Gratis</button>
          </div>
          <p class="mt-2 pl-1 text-xs text-slate-400">Huruf kecil dan angka. Bisa diganti saat daftar.</p>
        </form>

        <p class="mt-6 flex flex-wrap gap-x-5 text-sm">
          <a href="/login" class="inline-flex min-h-11 items-center text-slate-300 underline-offset-4 hover:text-white hover:underline">
            Sudah punya akun? Masuk
          </a>
          <a href="/demo" class="inline-flex min-h-11 items-center text-indigo-300 underline-offset-4 hover:text-indigo-200 hover:underline">
            Lihat toko demo
          </a>
        </p>
      </div>

      <figure class="relative mx-auto w-full max-w-[300px]">
        {/* Ilustrasi: semua isi placeholder, tidak bisa diklik, ikut berubah saat username diketik. */}
        <div
          class="pointer-events-none select-none rounded-[2.5rem] border border-white/15 bg-white/[0.03] p-3 shadow-[0_25px_70px_-15px_rgba(0,0,0,0.7)] backdrop-blur-2xl"
          aria-hidden="true"
        >
          <div class="overflow-hidden rounded-[2rem] border border-white/10 bg-night/90 px-4 pb-6 pt-3">
            <div class="mx-auto h-5 w-24 rounded-full bg-black"></div>

            <div class="relative mx-auto mt-6 w-fit">
              <div class="rounded-full bg-indigo-400 p-[3px]">
                <div id="mock-initials" class="flex size-16 items-center justify-center rounded-full border-[3px] border-night bg-night-raised font-display text-xl font-bold text-white">
                  NT
                </div>
              </div>
              <span class="absolute -bottom-0.5 -right-0.5 flex size-5 items-center justify-center rounded-full border-2 border-night bg-emerald-400 text-night">
                <svg viewBox="0 0 20 20" fill="currentColor" class="size-3"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 1 1 1.4-1.4l3.8 3.8 6.8-6.8a1 1 0 0 1 1.4 0Z" clip-rule="evenodd"></path></svg>
              </span>
            </div>
            <p class="mt-3 text-center font-display text-lg font-bold text-white">Nama Tokomu</p>
            <p class="mt-1.5 text-center">
              <span id="mock-username" class="inline-block max-w-full truncate rounded-full border border-white/10 bg-white/5 px-2.5 py-0.5 text-[11px] text-slate-300">@namatokomu</span>
            </p>

            <div class="mt-5 space-y-2">
              {
                ["Instagram", "TikTok"].map((name) => (
                  <div class="flex items-center gap-3 rounded-xl border border-white/10 bg-white/[0.05] p-2.5">
                    <span class="flex size-7 items-center justify-center rounded-lg border border-white/10 bg-white/5 text-slate-300">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-3.5"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" stroke-linecap="round" /></svg>
                    </span>
                    <span class="text-xs font-semibold text-white">{name}</span>
                  </div>
                ))
              }
              <div class="flex gap-3 rounded-xl border border-white/10 bg-white/[0.05] p-2.5">
                <span class="flex size-12 shrink-0 items-center justify-center rounded-lg border border-white/10 bg-white/5 text-slate-400">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="size-5"><path d="M3.5 7.5 12 3l8.5 4.5v9L12 21l-8.5-4.5v-9Z M3.5 7.5 12 12l8.5-4.5M12 12v9" stroke-linejoin="round" /></svg>
                </span>
                <div class="min-w-0 flex-1">
                  <p class="text-xs font-semibold text-white">Produk pertamamu</p>
                  <p class="mt-0.5 text-xs font-bold text-emerald-300">Rp 75.000</p>
                  <div class="mt-1 flex items-center justify-between">
                    <span class="text-[10px] text-slate-400">Stok: 12</span>
                    <span class="rounded-lg bg-linear-to-r/srgb from-indigo-600 via-violet-600 to-cyan-700 px-3 py-1 text-[10px] font-semibold text-white">Beli</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        {/* Kartu melayang: menggambarkan fitur yang ada, tanpa angka karangan. */}
        <div class="pointer-events-none absolute -top-5 left-0 flex items-center gap-2 rounded-xl border border-white/15 bg-night-raised/85 px-3 py-2 text-xs shadow-[0_8px_24px_rgba(0,0,0,0.45)] backdrop-blur-md md:-left-12" aria-hidden="true">
          <span class="size-2 rounded-full bg-emerald-400"></span>
          <span class="font-medium text-white">Pembayaran masuk</span>
          <span class="text-slate-400">QRIS</span>
        </div>
        <div class="pointer-events-none absolute bottom-12 right-0 flex items-center gap-2 rounded-xl border border-white/15 bg-night-raised/85 px-3 py-2 text-xs shadow-[0_8px_24px_rgba(0,0,0,0.45)] backdrop-blur-md md:-right-12" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5 text-cyan-300"><path d="M4 19V5M4 19h16M8 15l3-4 3 2 5-6" /></svg>
          <span class="font-medium text-white">Klik tercatat di dashboard</span>
        </div>

        <figcaption class="mt-10 text-center text-sm text-slate-400">Contoh tampilan. Ketik nama tokomu di kiri untuk melihatnya berubah.</figcaption>
      </figure>
    </section>

    {/* Bento: ukuran kartu mengikuti isinya; kartu lebar memuat ilustrasi, kartu sempit memuat daftar singkat. */}
    <section aria-labelledby="features-heading" class="mx-auto max-w-5xl px-5 pb-20">
      <h2 id="features-heading" class="text-2xl font-bold sm:text-3xl">Yang kamu dapat</h2>
      <div class="mt-6 grid grid-cols-1 gap-5 md:grid-cols-12">
        <article class="glass-card flex flex-col rounded-3xl p-6 md:col-span-7">
          <h3 class="text-xl font-bold">Tautan dan katalog digital dalam satu halaman</h3>
          <p class="mt-2 max-w-md leading-relaxed text-slate-300">
            Link Instagram, WhatsApp, atau marketplace di atas, kartu produk dengan harga dan stok di bawahnya. Urutkan dan sembunyikan
            dari dashboard.
          </p>
          <div class="mt-6 grid flex-1 grid-cols-[1fr_1.2fr] gap-3" aria-hidden="true">
            <div class="space-y-2">
              <div class="rounded-xl border border-white/10 bg-white/[0.05] px-3 py-2.5 text-sm font-semibold text-white">Instagram</div>
              <div class="rounded-xl border border-white/10 bg-white/[0.05] px-3 py-2.5 text-sm font-semibold text-white">WhatsApp</div>
              <div class="rounded-xl border border-white/10 bg-white/[0.05] px-3 py-2.5 text-sm font-semibold text-white">Shopee</div>
            </div>
            <div class="rounded-xl border border-white/10 bg-white/[0.05] p-3">
              <div class="flex aspect-[4/3] items-center justify-center rounded-lg border border-white/10 bg-white/[0.04] text-slate-400">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="size-8"><path d="M3.5 7.5 12 3l8.5 4.5v9L12 21l-8.5-4.5v-9Z M3.5 7.5 12 12l8.5-4.5M12 12v9" stroke-linejoin="round" /></svg>
              </div>
              <p class="mt-2 text-sm font-semibold text-white">Kopi Gayo 250 g</p>
              <p class="flex items-baseline justify-between gap-2 text-sm">
                <span class="font-bold text-emerald-300">Rp 75.000</span>
                <span class="text-xs text-slate-400">Stok: 12</span>
              </p>
            </div>
          </div>
        </article>

        <article class="glass-card flex flex-col rounded-3xl p-6 md:col-span-5">
          <h3 class="text-xl font-bold">Checkout instan lewat Midtrans</h3>
          <p class="mt-2 leading-relaxed text-slate-300">Pembeli bayar tanpa meninggalkan halaman tokomu.</p>
          <ul class="mt-5 flex flex-wrap gap-2" aria-label="Contoh metode pembayaran">
            {
              ["QRIS", "GoPay", "Virtual Account"].map((m) => (
                <li class="rounded-lg border border-white/10 bg-black/30 px-3 py-1.5 text-sm font-semibold text-white">{m}</li>
              ))
            }
          </ul>
          <p class="mt-2 text-xs text-slate-400">Metode yang tampil mengikuti yang aktif di akun Midtrans-mu.</p>
          <div class="mt-auto flex items-center justify-between rounded-xl border border-white/10 bg-white/[0.04] px-4 py-3 pt-3 text-sm max-md:mt-5">
            <span class="text-slate-300">Stok setelah lunas</span>
            <span class="font-semibold tabular-nums text-white">12 <span class="text-slate-400" aria-label="menjadi">→</span> 11</span>
          </div>
        </article>

        <article class="glass-card flex flex-col rounded-3xl p-6 md:col-span-5">
          <h3 class="text-xl font-bold">Kode promo dan produk digital</h3>
          <p class="mt-2 leading-relaxed text-slate-300">
            Buat kode diskon persen atau nominal dengan kuota. Jual e-book, preset, atau musik: file bisa diunduh dari struk begitu
            lunas.
          </p>
          <div class="mt-5 space-y-2" aria-hidden="true">
            <div class="flex items-center justify-between rounded-xl border border-dashed border-emerald-300/30 bg-emerald-400/[0.06] px-4 py-2.5">
              <span class="font-mono font-bold tracking-wide text-white">HEMAT20</span>
              <span class="text-sm font-semibold text-emerald-200">-20%</span>
            </div>
            <div class="flex items-center justify-between gap-3 rounded-xl border border-white/10 bg-white/[0.04] px-4 py-2.5">
              <span class="truncate text-sm text-white">ebook-resep-kopi.pdf</span>
              <span class="shrink-0 text-xs font-semibold text-cyan-200">Siap diunduh</span>
            </div>
          </div>
        </article>

        <article class="glass-card grid gap-6 rounded-3xl p-6 sm:grid-cols-[1fr_auto] md:col-span-7">
          <div class="flex flex-col">
            <h3 class="text-xl font-bold">Analitik dan QR Code kasir</h3>
            <p class="mt-2 leading-relaxed text-slate-300">
              Kunjungan, klik per item, dan pendapatan harian di dashboard. Cetak QR tokomu untuk ditempel di meja kasir.
            </p>
            <svg viewBox="0 0 168 64" preserveAspectRatio="xMinYMax meet" class="mt-auto h-16 w-full max-w-xs pt-4 max-sm:mt-5" aria-hidden="true">
              {bars.map((h, i) => <rect x={i * 24} y={64 - (h * 64) / 100} width="16" height={(h * 64) / 100} rx="4" fill={i === bars.length - 1 ? "#34d399" : "rgba(129,140,248,0.45)"} />)}
            </svg>
          </div>
          <figure class="w-fit">
            <div class="size-32 rounded-2xl bg-white p-2 [&>svg]:size-full" role="img" aria-label="QR code menuju toko demo">
              <Fragment set:html={demoQr} />
            </div>
            <figcaption class="mt-2 text-center text-xs text-slate-400">Scan: toko demo</figcaption>
          </figure>
        </article>
      </div>
    </section>
  </main>

  <SiteFooter />
</Base>

<script>
  // Pratinjau langsung: username yang diketik mengubah @username dan inisial di mockup ponsel.
  const input = document.querySelector<HTMLInputElement>("#claim-username");
  const mockUsername = document.querySelector<HTMLElement>("#mock-username");
  const mockInitials = document.querySelector<HTMLElement>("#mock-initials");

  input?.addEventListener("input", () => {
    // Aturan username sama dengan form daftar: huruf kecil dan angka saja.
    const value = input.value.toLowerCase().replace(/[^a-z0-9]/g, "").slice(0, 30);
    if (value !== input.value) input.value = value;
    if (mockUsername) mockUsername.textContent = `@${value || "namatokomu"}`;
    if (mockInitials) mockInitials.textContent = (value.slice(0, 2) || "nt").toUpperCase();
  });
</script>
