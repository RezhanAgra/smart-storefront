---
import AuthCard from "../components/AuthCard.astro";
---

<AuthCard title="Lupa password | smart-storefront" heading="Lupa password" intro="Masukkan email akunmu. Kami kirim tautan untuk membuat password baru, berlaku 1 jam.">
  <form id="forgot-form" class="mt-6 space-y-4" novalidate>
    <div>
      <label for="email" class="label">Email</label>
      <input id="email" name="email" type="email" autocomplete="email" required class="glass-input mt-1" />
    </div>
    <button type="submit" class="btn-glow w-full rounded-xl">Kirim tautan reset</button>
    <p id="result" role="status" class="text-sm text-slate-300" hidden></p>
    <p id="error" role="alert" class="text-sm text-rose-200" hidden></p>
  </form>
  <a href="/login" class="mt-4 inline-flex min-h-11 items-center text-sm text-indigo-300 underline-offset-4 hover:underline">Kembali ke halaman masuk</a>
</AuthCard>

<script>
  import { API_URL, errorMessage } from "../lib/api";

  const form = document.querySelector<HTMLFormElement>("#forgot-form")!;
  const email = document.querySelector<HTMLInputElement>("#email")!;
  const button = form.querySelector<HTMLButtonElement>("button")!;
  const result = document.querySelector<HTMLElement>("#result")!;
  const error = document.querySelector<HTMLElement>("#error")!;
  const show = (el: HTMLElement, text: string) => {
    result.hidden = error.hidden = true;
    el.textContent = text;
    el.hidden = false;
  };

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!email.checkValidity()) {
      show(error, "Masukkan alamat email yang valid.");
      email.focus();
      return;
    }
    button.disabled = true;
    button.textContent = "Mengirim...";
    try {
      const res = await fetch(`${API_URL}/api/auth/forgot-password`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email: email.value.trim() }),
      });
      if (!res.ok) {
        show(error, await errorMessage(res, "Gagal mengirim tautan. Coba lagi."));
        return;
      }
      show(result, ((await res.json()) as { message: string }).message);
    } catch {
      show(error, "Tidak bisa terhubung ke server.");
    } finally {
      button.disabled = false;
      button.textContent = "Kirim tautan reset";
    }
  });
</script>
