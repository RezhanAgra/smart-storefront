---
import AuthCard from "../components/AuthCard.astro";

const token = Astro.url.searchParams.get("token") ?? "";
const validShape = /^[a-f0-9]{64}$/.test(token);
---

<AuthCard title="Password baru | smart-storefront" heading="Buat password baru" intro="Setelah tersimpan, masuk dengan password baru ini.">
  {
    validShape ? (
      <form id="reset-form" class="mt-6 flex flex-col gap-4" novalidate data-token={token}>
        <div>
          <label for="password" class="label">Password baru</label>
          <input id="password" type="password" autocomplete="new-password" required minlength="8" aria-describedby="password-hint" class="glass-input mt-1" />
          <p id="password-hint" class="mt-1.5 text-sm text-slate-400">Minimal 8 karakter.</p>
        </div>
        <button type="submit" class="btn-glow w-full rounded-xl">Simpan password</button>
        <p id="error" role="alert" class="text-sm text-rose-200" hidden />
      </form>
    ) : (
      <p class="mt-6 rounded-xl border border-rose-400/30 bg-rose-500/10 px-3 py-2 text-sm text-rose-200">
        Tautan ini tidak lengkap. Buka lagi tautan dari email, atau minta tautan baru.
      </p>
    )
  }
  <div id="done" class="mt-6" hidden>
    <p role="status" class="text-sm text-emerald-200">Password baru tersimpan.</p>
    <a href="/login" class="btn-glow mt-4 w-full rounded-xl">Masuk</a>
  </div>
  {!validShape && <a href="/lupa-password" class="btn-ghost mt-4 w-full">Minta tautan baru</a>}
</AuthCard>

<script>
  import { API_URL, errorMessage } from "../lib/api";

  const form = document.querySelector<HTMLFormElement>("#reset-form");
  if (form) {
    const password = form.querySelector<HTMLInputElement>("#password")!;
    const button = form.querySelector<HTMLButtonElement>("button")!;
    const error = form.querySelector<HTMLElement>("#error")!;
    const fail = (text: string) => {
      error.textContent = text;
      error.hidden = false;
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      error.hidden = true;
      if (!password.checkValidity()) {
        fail("Password minimal 8 karakter.");
        password.focus();
        return;
      }
      button.disabled = true;
      button.textContent = "Menyimpan...";
      try {
        const res = await fetch(`${API_URL}/api/auth/reset-password`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ token: form.dataset.token, password: password.value }),
        });
        if (!res.ok) {
          fail(await errorMessage(res, "Gagal menyimpan password."));
          return;
        }
        form.hidden = true;
        const done = document.querySelector<HTMLElement>("#done")!;
        done.hidden = false;
        done.querySelector("a")!.focus();
      } catch {
        fail("Tidak bisa terhubung ke server.");
      } finally {
        button.disabled = false;
        button.textContent = "Simpan password";
      }
    });
  }
</script>
