# URL API Express. Dipakai oleh SSR (server Astro) dan oleh script di browser.
PUBLIC_API_URL="http://localhost:5000"
# URL publik client ini, untuk canonical/og:url dan alamat toko yang ditampilkan.
SITE_URL="http://localhost:4321"
# Harus sama dengan INTERNAL_API_KEY di server/.env. Hanya dipakai di SSR, tidak pernah dikirim ke browser.
INTERNAL_API_KEY="ganti_dengan_string_acak_panjang"
