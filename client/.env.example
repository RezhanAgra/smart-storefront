# URL API Express. Dipakai oleh SSR (server Astro) dan oleh script di browser.
PUBLIC_API_URL="http://localhost:5000"
# URL publik client ini, untuk canonical/og:url dan alamat toko yang ditampilkan.
SITE_URL="http://localhost:4321"
# Harus sama dengan INTERNAL_API_KEY di server/.env. Hanya dipakai di SSR, tidak pernah dikirim ke browser.
INTERNAL_API_KEY="ganti_dengan_string_acak_panjang"
# Ditampilkan di Syarat & Ketentuan, Kebijakan Privasi, dan Kebijakan Refund. Wajib diisi sebelum rilis.
# contoh: SITE_OPERATOR_NAME="Nama Penyelenggara / PT Contoh Digital" (kosong = halaman legal menampilkan penanda [ISI SITE_OPERATOR_NAME])
SITE_OPERATOR_NAME=""
# contoh: SITE_CONTACT_EMAIL="legal@domainkamu.com" (kosong = halaman legal menampilkan penanda [ISI SITE_CONTACT_EMAIL])
SITE_CONTACT_EMAIL=""
